# The stylesheet was cached for four hours while the HTML was not, so a phone
# could hold new markup and an old stylesheet at the same time — which is
# exactly how the screenshots ended up 1600px wide and hanging off the right
# on 2026-08-07. Match the HTML: always revalidate. Cheap; the file is 8 KB.
# The hashed stylesheet is safe to cache hard and forever: its name changes
# whenever its contents do, so a cached copy can never be the wrong one.
/kadaken.*.css
  Cache-Control: public, max-age=31536000, immutable

# The unhashed copy is only a fallback, so it must stay fresh.
/kadaken.css
  Cache-Control: public, max-age=0, must-revalidate

# Unhashed, and it is what keeps every version label on the site correct, so a
# stale copy is worse than a re-request. Revalidate every time.
/fill-versions.js
  Cache-Control: public, max-age=0, must-revalidate

# The download filenames are stable across releases, so the same URL has new
# bytes behind it after every publish. Without this the edge keeps serving the
# previous build under the current name — verified happening on 4.7.3. Short
# TTL plus revalidate means the edge checks the ETag instead of guessing.
/download/*
  Cache-Control: public, max-age=60, must-revalidate

# The update file must not be served stale — apps ask for it at most hourly.
/awbn-update.json
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
